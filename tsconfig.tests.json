{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-dist",
    "rootDir": ".",
    "noEmit": false
  },
  "include": [
    "src/types.ts",
    "src/utils.ts",
    "src/backup.ts",
    "tests/*.test.ts",
    "tests/node-shims.d.ts"
  ]
}
